<mxfile>
  <diagram name="Agent Flow" id="agent-flow-serambi-ai">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Serambi.ai — 6 Agent Interaction Flow" style="text;html=1;fontStyle=1;fontSize=18;fontColor=1E2761;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="820" height="40" as="geometry"/>
        </mxCell>

        <!-- User input -->
        <mxCell id="user" value="Career Switcher&#xa;&#xa;'jadi data analyst&#xa;dalam 3 bulan'" style="ellipse;whiteSpace=wrap;html=1;fillColor=#1E2761;fontColor=#FFFFFF;strokeColor=#1E2761;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="60" width="160" height="90" as="geometry"/>
        </mxCell>

        <!-- Agent 1 -->
        <mxCell id="a1" value="1. Goal Agent&#xa;goal_decomposer&#xa;&#xa;Goal -&gt; Roadmap JSON&#xa;(deadline, milestones,&#xa;first_action)&#xa;&#xa;LIVE e2e verified" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7DFFB0;strokeColor=#27ae60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="200" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Agent 2 -->
        <mxCell id="a2" value="2. Tutor Agent&#xa;explain_concept&#xa;&#xa;Feynman technique&#xa;Probing questions&#xa;No direct answers&#xa;&#xa;In development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="200" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Agent 3 -->
        <mxCell id="a3" value="3. Assessment Agent&#xa;generate_quiz&#xa;&#xa;Adaptive quiz&#xa;Graduated hints&#xa;(smallest hint first)&#xa;&#xa;In development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="620" y="380" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Agent 4 -->
        <mxCell id="a4" value="4. Progress Agent&#xa;check_progress&#xa;&#xa;Forgetting curve&#xa;Spaced repetition&#xa;+15-20% retention&#xa;&#xa;In development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="360" y="560" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Agent 5 -->
        <mxCell id="a5" value="5. Motivator Agent&#xa;send_reminder&#xa;&#xa;Contextual nudge&#xa;Next action prompt&#xa;Progress-aware&#xa;&#xa;In development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="380" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- Agent 6 -->
        <mxCell id="a6" value="6. Wellbeing Agent&#xa;check_wellbeing&#xa;&#xa;Burnout detection&#xa;Engagement check-in&#xa;Reduce dropout&#xa;&#xa;In development" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="100" y="200" width="160" height="120" as="geometry"/>
        </mxCell>

        <!-- MCP label -->
        <mxCell id="mcp-label" value="All agents exposed as named MCP tools via IBM Langflow" style="text;html=1;fontStyle=2;fontSize=12;fontColor=555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="715" width="820" height="30" as="geometry"/>
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-user-a1" value="goal input" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#27ae60;strokeWidth=2;" edge="1" source="user" target="a1" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a1-a2" value="milestone context" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="a1" target="a2" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a2-a3" value="concept studied" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="a2" target="a3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a3-a4" value="quiz result" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="a3" target="a4" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a4-a5" value="progress signal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="a4" target="a5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a5-a6" value="engagement signal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;" edge="1" source="a5" target="a6" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a6-user" value="motivational nudge" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;" edge="1" source="a6" target="user" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-a4-user" value="review schedule" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;dashed=1;" edge="1" source="a4" target="user" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
