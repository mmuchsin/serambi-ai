<mxfile>
  <diagram name="Architecture" id="arch-serambi-ai">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Serambi.ai — System Architecture" style="text;html=1;fontStyle=1;fontSize=18;fontColor=1E2761;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="860" height="40" as="geometry"/>
        </mxCell>

        <!-- Dev Lane -->
        <mxCell id="dev-lane" value="Development Harness (Now)" style="swimlane;horizontal=0;startSize=110;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="920" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="bob" value="IBM Bob TUI&#xa;(AI Agent Harness)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;fontColor=#FFFFFF;strokeColor=#1E2761;fontSize=13;fontStyle=1;" vertex="1" parent="dev-lane">
          <mxGeometry x="120" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-dev" value="MCP&#xa;(streamable HTTP&#xa;x-api-key)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="dev-lane">
          <mxGeometry x="380" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lf-dev" value="IBM Langflow&#xa;(Flow Engine)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="dev-lane">
          <mxGeometry x="620" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-bob-mcp" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1E2761;strokeWidth=2;" edge="1" source="bob" target="mcp-dev" parent="dev-lane">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-mcp-lf-dev" value="JSON-RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1E2761;strokeWidth=2;" edge="1" source="mcp-dev" target="lf-dev" parent="dev-lane">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Prod Lane -->
        <mxCell id="prod-lane" value="Production (Target)" style="swimlane;horizontal=0;startSize=110;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="240" width="920" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="webapp" value="Web App Backend&#xa;(apps/web)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;fontColor=#FFFFFF;strokeColor=#1E2761;fontSize=13;fontStyle=1;" vertex="1" parent="prod-lane">
          <mxGeometry x="120" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="mcp-prod" value="MCP&#xa;(same contract)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=13;" vertex="1" parent="prod-lane">
          <mxGeometry x="380" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="lf-prod" value="IBM Langflow&#xa;(same flows)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;fontStyle=1;" vertex="1" parent="prod-lane">
          <mxGeometry x="620" y="50" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-webapp-mcp" value="tool call" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="webapp" target="mcp-prod" parent="prod-lane">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-mcp-lf-prod" value="JSON-RPC" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;" edge="1" source="mcp-prod" target="lf-prod" parent="prod-lane">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- LLM -->
        <mxCell id="llm" value="NaraRouter&#xa;longcat-2.5 (LLM)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="280" width="160" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-lf-dev-llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="lf-dev" target="llm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e-lf-prod-llm" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#b85450;strokeWidth=2;dashed=1;" edge="1" source="lf-prod" target="llm" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Same contract label -->
        <mxCell id="contract-label" value="Same MCP contract — No Langflow changes needed" style="text;html=1;fontStyle=2;fontSize=12;fontColor=555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="340" y="415" width="320" height="30" as="geometry"/>
        </mxCell>

        <!-- User -->
        <mxCell id="user" value="Career Switcher&#xa;(End User)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="280" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="e-user-webapp" value="natural language" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;" edge="1" source="user" target="webapp" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Verified badge -->
        <mxCell id="verified" value="e2e verified: goal_decomposer (Bob -&gt; Langflow -&gt; JSON roadmap)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7DFFB0;strokeColor=#27ae60;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="460" width="380" height="36" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
