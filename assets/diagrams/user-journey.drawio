        </mxCell>
        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="n4" target="a3n" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;strokeWidth=2;" edge="1" source="a4n" target="n5" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e6" value="loop: next milestone" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#82b366;strokeWidth=2;dashed=1;" edge="1" source="n5" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="55"/><mxPoint x="1010" y="30"/><mxPoint x="590" y="30"/></Array></mxGeometry>
        </mxCell>
        <mxCell id="ewb" value="nudge / alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;" edge="1" source="wb2" target="n3" parent="1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="time-label" value="&lt; 1 menit untuk roadmap  |  Ongoing learning loop per milestone  |  Review dijadwalkan adaptif (Zaidi et al. +15-20% retensi)" style="text;html=1;fontStyle=2;fontSize=12;fontColor=555555;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="1100" height="30" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
