<mxfile>
  <diagram name="User Journey" id="user-journey-serambi-ai">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Title -->
        <mxCell id="title" value="Serambi.ai — Career Switcher Learning Journey" style="text;html=1;fontStyle=1;fontSize=18;fontColor=1E2761;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1100" height="40" as="geometry"/>
        </mxCell>

        <!-- Lane 1: Career Switcher -->
        <mxCell id="lane1" value="Career Switcher" style="swimlane;horizontal=0;startSize=110;fillColor=#f5f5f5;strokeColor=#999999;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="60" width="1200" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="n1" value="Tulis goal karier&#xa;dalam bahasa natural" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E2761;fontColor=#FFFFFF;strokeColor=#1E2761;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="120" y="40" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="Terima roadmap&#xa;mingguan personal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7DFFB0;strokeColor=#27ae60;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="320" y="40" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="Pelajari konsep&#xa;milestone ini" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="520" y="40" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="Jawab kuis adaptif&#xa;&amp; cek pemahaman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="720" y="40" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n5" value="Review terjadwal&#xa;&amp; milestone selesai" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="lane1">
          <mxGeometry x="920" y="40" width="140" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="eu1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" source="n1" target="n2" parent="lane1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" source="n2" target="n3" parent="lane1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" source="n3" target="n4" parent="lane1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eu4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#666666;strokeWidth=2;" edge="1" source="n4" target="n5" parent="lane1">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Lane 2: Serambi.ai Agents -->
        <mxCell id="lane2" value="Serambi.ai Agents (MCP)" style="swimlane;horizontal=0;startSize=110;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="200" width="1200" height="160" as="geometry"/>
        </mxCell>
        <mxCell id="a1n" value="Goal Agent&#xa;goal_decomposer&#xa;LIVE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7DFFB0;strokeColor=#27ae60;fontSize=12;fontStyle=1;" vertex="1" parent="lane2">
          <mxGeometry x="300" y="50" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a2n" value="Tutor Agent&#xa;explain_concept&#xa;Feynman" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane2">
          <mxGeometry x="490" y="50" width="140" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="a3n" value="Assessment Agent&#xa;generate_quiz&#xa;Graduated hints" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane2">
          <mxGeometry x="680" y="50" width="140" height="70" as="geometry"/>
