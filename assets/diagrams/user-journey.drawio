        <mxCell id="ea2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;" edge="1" source="a2n" target="a3n" parent="lane2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ea3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#6c8ebf;" edge="1" source="a3n" target="a4n" parent="lane2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Lane 3: Support Loop -->
        <mxCell id="lane3" value="Support Loop" style="swimlane;horizontal=0;startSize=110;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=13;html=1;" vertex="1" parent="1">
          <mxGeometry x="0" y="360" width="1200" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="wb1" value="Wellbeing Agent&#xa;Burnout detection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="490" y="30" width="160" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="wb2" value="Motivator Agent&#xa;Contextual nudge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="lane3">
          <mxGeometry x="710" y="30" width="160" height="60" as="geometry"/>
        </mxCell>

        <!-- Cross-lane edges -->
        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#1E2761;strokeWidth=2;" edge="1" source="n1" target="a1n" parent="1">
          <mxGeometry relative="1" as="geometry"/>
