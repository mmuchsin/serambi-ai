        <mxCell id="a4n" value="Progress Agent&#xa;check_progress&#xa;Spaced repetition" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="lane2">
